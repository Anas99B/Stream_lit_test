{
  "name": "arab-tech-explainer-reels",
  "version": "1.0.0",
  "description": "Arabic tech explainer reels (style arab-tech-explainer-v1) built with Remotion",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/noto-sans-mono": "5.3.0",
    "@remotion/captions": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/paths": "4.0.534",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.534",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "build:timeline": "node scripts/build_timeline.mjs",
    "build:avatar": "python3 -I scripts/prepare_avatar.py",
    "build:sfx": "python3 -I scripts/make_sfx.py",
    "preview:mcp": "remotion render McpEpisode out/mcp_ep01_v2_preview_0-12s.mp4 --frames=0-719 --codec=h264 --crf=17 --image-format=png --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=192k",
    "render:mcp": "remotion render McpEpisode out/mcp_ep01_v2_master.mp4 --codec=h264 --crf=17 --image-format=png --pixel-format=yuv420p --color-space=bt709 --audio-codec=aac --audio-bitrate=192k",
    "still:mcp-cover": "remotion still McpCover out/mcp_ep01_v2_cover.png --image-format=png"
  }
}
